pipeline {
    agent any

    environment {
        DOCKERHUB_CREDS = credentials('lab_big_data_two')
        LC_ALL = "en_US.UTF-8"
        LANG = "en_US.UTF-8"
        LANGUAGE = "en_US.UTF-8"
    }

    options {
        timestamps()
        skipDefaultCheckout(false)
    }

    stages {

        stage('Clone github repository') {
            steps {
                cleanWs()
                bat 'chcp 65001 && git clone -b develop https://github.com/Lammirea/big_data_lab_second.git'
            }
        }

        stage('Checkout repo dir') {
            steps {
                bat 'chcp 65001 && cd big_data_lab_second && dir'
            }
        }

        stage('Login') {
            steps {
                bat 'chcp 65001 && docker login -u %DOCKERHUB_CREDS_USR% -p %DOCKERHUB_CREDS_PSW%'
            }
        }

        stage('Create and run docker container') {
            steps {
                script {
                    // проверим наличие каталога и docker-compose.yml и соберём/поднимем
                    bat '''
                        chcp 65001
                        dir
                        if exist "big_data_lab_second" (
                            pushd big_data_lab_second
                            if exist "docker-compose.yml" (
                                echo "docker-compose.yml found"
                                docker-compose build
                                exit /b %ERRORLEVEL%
                            ) else (
                                echo "ERROR: docker-compose.yml not found"
                                exit /b 1
                            )
                            popd
                        ) else (
                            echo "ERROR: Directory big_data_lab_second not found"
                            dir
                            exit /b 1
                        )
                    '''
                    dir('big_data_lab_second') {
                        withCredentials([
                            string(credentialsId: 'redis-password', variable: 'REDIS_PASSWORD'),
                            string(credentialsId: 'redis-host', variable: 'REDIS_HOST'),
                            string(credentialsId: 'redis-port', variable: 'REDIS_PORT'),
                            string(credentialsId: 'redis-user-password', variable: 'REDIS_USER_PASSWORD'),
                            string(credentialsId: 'redis-db', variable: 'REDIS_DB')
                        ]) {
                            bat '''
                                chcp 65001
                                echo REDIS_HOST=%REDIS_HOST% > .env
                                echo REDIS_PORT=%REDIS_PORT% >> .env
                                echo REDIS_DB=%REDIS_DB% >> .env
                                echo REDIS_PASSWORD=%REDIS_PASSWORD% >> .env
                                echo REDIS_USER_PASSWORD=%REDIS_USER_PASSWORD% >> .env
                                docker-compose up -d
                            '''
                        }
                    }
                }
            }
        }

        stage('Wait for App Ready') {
            steps {
                script {
                    // timeout wrapper от Jenkins останется, но внутри используем windows bat
                    timeout(time: 120, unit: 'SECONDS') {
                        bat '''
                            chcp 65001
                            echo Waiting for application to be ready...
                            pushd big_data_lab_second

                            rem Попробуем ожидать ответ 200 с помощью curl (Windows curl)
                            rem Используем цикл for /l и ping для паузы (timeout может падать в CI)
                            set ok=0
                            for /l %%i in (1,1,60) do (
                                rem выполняем запрос и проверяем код
                                curl -s -o nul -w "%%{http_code}" http://localhost:8090/ 2>nul | findstr "200" >nul
                                if not errorlevel 1 (
                                    set ok=1
                                    echo Application is ready!
                                    goto :afterloop
                                )
                                echo Waiting for app to be ready... Attempt %%i/60
                                rem пауза ~2 секунды
                                ping -n 3 127.0.0.1 >nul
                            )

                            :afterloop
                            if "%ok%"=="1" (
                                echo App started successfully
                                popd
                            ) else (
                                echo ERROR: Application failed to start within timeout
                                echo Printing docker-compose logs...
                                docker-compose logs
                                popd
                                exit /b 1
                            )
                        '''
                    }
                }
            }
        }

        stage('Run Functional Tests Inside Container') {
            steps {
                script {
                    bat '''
                        chcp 65001
                        rem Найдём контейнер(ы) с именем содержащим "api" или "web" (подберите фильтр под ваш compose)
                        set TEST_DONE=0
                        for /f "tokens=*" %%i in ('docker ps -qf "name=api"') do (
                            echo Running tests in container %%i
                            docker exec %%i pytest -v tests/test_functional.py
                            if errorlevel 1 (
                                echo Tests failed in container %%i
                                exit /b 1
                            ) else (
                                set TEST_DONE=1
                            )
                        )
                        if "%TEST_DONE%"=="0" (
                            echo No container found matching name filter "api"
                            docker ps -a
                            exit /b 1
                        )
                    '''
                }
            }
        }
    }

    post {
        always {
            bat '''
                chcp 65001
                echo "Cleaning up containers..."
                docker stop big_data_lab_second-web-1 2>nul || echo "Container big_data_lab_second-web-1 not running"
                docker stop redis_db 2>nul || echo "Container redis_db not running"
                docker rm big_data_lab_second-web-1 2>nul || echo "Container big_data_lab_second-web-1 not found"
                docker rm redis_db 2>nul || echo "Container redis_db not found"
                docker rmi derelia/big_data_lab_second:latest 2>nul || echo "Image not found"
                docker logout 2>nul || echo "Not logged in"
            '''
            cleanWs()
        }
    }
}
